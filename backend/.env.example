# Copy to backend/.env and fill in. Never commit the real .env.

# Required for Firebase auth: must match VITE_FIREBASE_PROJECT_ID in frontend/.env
FIREBASE_PROJECT_ID=your-firebase-project-id
# Optional: path to a service-account JSON (only needed for Admin SDK features
# beyond token verification, e.g. setting custom claims)
FIREBASE_CREDENTIALS_FILE=

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
